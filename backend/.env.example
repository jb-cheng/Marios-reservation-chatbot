# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Values may be pasted with or without surrounding quotes, and stray whitespace is
# ignored, so copying a key straight out of a dashboard or a JSON snippet works.
# Restart the backend after editing this file: it is read once at startup.

# --- LLM provider -----------------------------------------------------------
# cohere | groq | gemini | fake
# "fake" is deterministic rule-based extraction with no network calls, which is
# what the test suite and an offline demo run against.
LLM_PROVIDER=fake
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Cohere Command A+ deployment id. Leave blank to have scripts/list_models.py
# tell you what your account actually serves.
COHERE_MODEL=
# Groq fast path, eg openai/gpt-oss-120b
GROQ_MODEL=
GEMINI_MODEL=

# Milliseconds before the provider chain moves on to the next entry.
# Measured on Command A+: 1.9s to 6.1s per structured turn, the slow one being the
# turn that carries an availability block. Set this above the tail you are willing
# to wait out, not below the median, or every slow turn silently degrades to the
# fallback provider.
LLM_TIMEOUT_MS=15000

# --- Guardrails -------------------------------------------------------------
# Prompt Guard 2 runs on Groq: meta-llama/llama-prompt-guard-2-86m or -22m
GUARDRAILS_ENABLED=false
GUARDRAILS_MODEL=meta-llama/llama-prompt-guard-2-86m
# openai/gpt-oss-safeguard-20b on the outgoing reply. Doubles the model calls per
# turn, so it is off unless you are presenting on it.
SAFEGUARD_ENABLED=false
SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b

# --- Email ------------------------------------------------------------------
# A key and a sender together select Resend. Without both, messages are written to
# backend/outbox as .eml files and logged, which is enough to screenshot and enough
# to test.
RESEND_API_KEY=
# The address Resend sends as. Until a domain is verified at resend.com/domains the
# only usable value is onboarding@resend.dev, and Resend then delivers solely to the
# address the account was created with. Blank falls back to the outbox rather than
# posting an empty from.
EMAIL_FROM=
EMAIL_TO_STAFF=

# --- Speech -----------------------------------------------------------------
# ElevenLabs is optional and covers both halves of voice mode: spoken replies and
# transcription. Without a key, replies fall back to Edge TTS and then to the
# browser's own voice, and the microphone falls back to the browser's recognition.
#
# The key is the long string under elevenlabs.io, Profile, API Keys. It is not a
# voice id. Voice ids are 20 characters of mixed case, for example
# 21m00Tcm4TlvDq8ikWAM, and pasting one into the key field makes every speech
# request fail with 401 invalid_api_key while the server still reports the
# provider as configured.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
# Edge TTS voice, used when there is no ElevenLabs key or the call fails.
TTS_VOICE=en-US-AriaNeural

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=backend/reservations.db

# --- Restaurant -------------------------------------------------------------
# Overridden only for tests. Everything else about the restaurant lives in
# backend/app/config.py so there is one place to edit it.
RESTAURANT_NAME=Mario's
